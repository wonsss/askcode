# Claude
ANTHROPIC_API_KEY=
ASKCODE_MODEL_LARGE=claude-sonnet-5-5
ASKCODE_MODEL_SMALL=claude-haiku-5-5
ASKCODE_AGENT_MAX_TURNS=12
ASKCODE_AGENT_MAX_BUDGET_USD=0.5
# 단순 호출 비용 추정용 단가 (USD / 100만 토큰) — 현재 가격표에 맞게
ASKCODE_PRICE_SMALL_INPUT=1.0
ASKCODE_PRICE_SMALL_OUTPUT=5.0

# GitHub App (권장): Contents·Metadata 읽기 전용, 대상 레포에만 설치
ASKCODE_GITHUB_APP_ID=
ASKCODE_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
ASKCODE_GITHUB_APP_INSTALLATION_ID=
# 또는 개발용 읽기 전용 토큰 (공개 레포면 비워 둬도 됨)
ASKCODE_GITHUB_TOKEN=

# Slack (Socket Mode)
ASKCODE_SLACK_BOT_TOKEN=xoxb-
ASKCODE_SLACK_APP_TOKEN=xapp-
# '개발자에게 확인 요청' 버튼이 글을 올릴 채널 ID (선택)
ASKCODE_ESCALATION_CHANNEL=
# 소스로 읽을 공개 채널 ID (쉼표 구분, 선택) · 기간(일)
ASKCODE_SLACK_SOURCE_CHANNELS=
ASKCODE_SLACK_SOURCE_DAYS=90

# Notion (봇 전용 내부 통합, 콘텐츠 읽기만) — 선택
ASKCODE_NOTION_TOKEN=
ASKCODE_NOTION_ROOT_PAGE_ID=

# 저장 위치
ASKCODE_DATA_DIR=./data
